{
  "name": "weekly-schedules",
  "private": true,
  "type": "module",
  "description": "Dev-only tooling: the app itself is static files (index.html, app.css, js/) served as they are, with no build or dependencies.",
  "engines": { "node": ">=22" },
  "scripts": {
    "serve": "node tests/e2e/serve.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:all": "vitest run && playwright test",
    "lint": "eslint js tests",
    "shots": "playwright test -c tests/shots/playwright.config.js"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^9.0.0",
    "@playwright/test": "^1.50.0",
    "eslint": "^9.0.0",
    "eslint-scope": "^8.4.0",
    "espree": "^10.4.0",
    "globals": "^15.0.0",
    "jsdom": "^25.0.0",
    "vitest": "^5.0.4"
  }
}
